# ---------------------------------------------------------------------------
# Faceless Video Maker - configuration
# Copy to .env and edit. Every value is optional: the app runs fully offline
# with the defaults below.
# ---------------------------------------------------------------------------

# --- Script generation -----------------------------------------------------
# Leave OPENAI_API_KEY empty to use the built-in offline scriptwriter.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, OpenRouter,
# Ollama, LM Studio, vLLM ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Voice -----------------------------------------------------------------
# Any edge-tts voice name. GET /api/voices lists them all.
FVM_DEFAULT_VOICE=en-US-AndrewNeural
FVM_TTS_RATE=+8%

# --- Render ----------------------------------------------------------------
FVM_WIDTH=1080
FVM_HEIGHT=1920
FVM_FPS=30
FVM_CRF=20
FVM_PRESET=veryfast
FVM_MAX_WORKERS=1

# --- Storage ---------------------------------------------------------------
# FVM_DATA_DIR=./data
# FVM_OUTPUT_DIR=./output
